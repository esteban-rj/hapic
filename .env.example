# Optional for local process. Never commit the populated .env file.
# The launcher loads this file on the server only.
OPENAI_API_KEY=
HERMES_IMAGE=nousresearch/hermes-agent:stable
# Model used by the persistent image-generation tool (separate from chat model).
HAPIC_IMAGE_MODEL=gpt-image-2.5-flare
# For Compose, use the absolute host path; scripts/start-docker.ps1 sets it.
# HAPIC_HOST_DATA_DIR=C:/Users/your-user/Documents/Github/hapic/.hapic
# YouTube OAuth is configured by the operator. Set paths, never inline JSON or client secrets.
# Native server: HAPIC_YOUTUBE_CLIENT_FILE=/absolute/private/path/google-oauth.json
# Docker Compose override: HAPIC_YOUTUBE_CLIENT_JSON=/absolute/private/path/google-oauth.json

# Optional LiteLLM stack (scripts/start-docker.sh --litellm).
# Generate distinct values with openssl rand -hex 32. Prefix the master key with sk-.
# Keep the LiteLLM salt and database password stable across starts.
# LITELLM_MASTER_KEY=
# LITELLM_SALT_KEY=
# LITELLM_POSTGRES_PASSWORD=
# HAPIC_LITELLM_PORT=4000
# HAPIC_LITELLM_BEST_MODEL=best-model
# Optional gateway alias for a PNG image-generation model.
# HAPIC_LITELLM_IMAGE_MODEL=
# Optional virtual key. You can also save it in Hapic Settings → LiteLLM.
# HAPIC_LITELLM_API_KEY=
# For a separately managed gateway, use its reachable API base and browser-facing dashboard.
# HAPIC_LITELLM_BASE_URL=https://your-gateway.example/v1
# HAPIC_LITELLM_DASHBOARD_URL=https://your-gateway.example/ui
# Optional API base reachable from Hermes when it differs from the backend's base.
# HAPIC_LITELLM_HERMES_BASE_URL=http://litellm:4000/v1
